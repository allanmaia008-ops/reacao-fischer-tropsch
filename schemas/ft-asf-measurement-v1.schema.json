{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reacao-fischer-tropsch.local/schemas/ft-asf-measurement-v1.schema.json",
  "title": "Contrato de comparação ASF versus medição v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "comparison_id", "alpha", "representation", "measured_fractions", "measurement_basis", "evidence_status", "source_ids"],
  "properties": {
    "contract_version": {"const": "1.0.0"},
    "comparison_id": {"type": "string", "minLength": 1},
    "alpha": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
    "representation": {"enum": ["carbon_number", "product_bands"]},
    "measured_fractions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}
    },
    "measurement_basis": {"const": "carbon_fraction_hydrocarbons"},
    "evidence_status": {"enum": ["synthetic", "extracted", "verified", "approved"]},
    "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "measured_uncertainty": {
      "type": "object",
      "additionalProperties": {"type": "number", "minimum": 0}
    },
    "closure_tolerance_pct": {"type": "number", "minimum": 0, "default": 2.0}
  }
}
