{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reacao-fischer-tropsch:catalyst:1.0.0",
  "title": "Lote de catalisador Fischer-Tropsch v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "catalyst_id", "batch_id", "display_name",
    "active_family", "nominal_composition", "precursor", "support",
    "active_metal_loading_wt_pct", "promoters", "preparation_method",
    "preparation_steps", "activation", "active_phase",
    "characterization_evidence_ids", "provenance"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "catalyst_id": {"type": "string", "minLength": 1},
    "batch_id": {"type": "string", "minLength": 1},
    "display_name": {"type": "string", "minLength": 1},
    "active_family": {"enum": ["Co", "Fe", "Co-Fe"]},
    "nominal_composition": {"type": "string", "minLength": 1},
    "scientific_hypothesis": {"type": ["string", "null"], "minLength": 1},
    "precursor": {"type": "string", "minLength": 1},
    "support": {"type": "string", "minLength": 1},
    "active_metal_loading_wt_pct": {"type": "number", "exclusiveMinimum": 0, "maximum": 100},
    "promoters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "loading_wt_pct"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "loading_wt_pct": {"type": "number", "exclusiveMinimum": 0, "maximum": 100},
          "precursor": {"type": ["string", "null"], "minLength": 1}
        }
      }
    },
    "preparation_method": {"type": "string", "minLength": 1},
    "preparation_steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "temperature_c": {"type": ["number", "null"], "exclusiveMinimum": -273.15},
          "duration_h": {"type": ["number", "null"], "exclusiveMinimum": 0},
          "atmosphere": {"type": ["string", "null"], "minLength": 1}
        }
      }
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gas", "temperature_c", "duration_h"],
      "properties": {
        "gas": {"type": "string", "minLength": 1},
        "temperature_c": {"type": "number", "exclusiveMinimum": -273.15},
        "duration_h": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "active_phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "status", "evidence_ids"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "status": {"enum": ["medida", "inferida", "hipotetica"]},
        "evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "particle_size_um": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "dispersion_pct": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "characterization_evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "storage_conditions": {"type": ["string", "null"], "minLength": 1},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "source_reference", "license", "curator", "recorded_at"],
      "properties": {
        "source_type": {"enum": ["experimento_interno", "literatura", "fornecedor", "legado"]},
        "source_reference": {"type": "string", "minLength": 1},
        "license": {"type": "string", "minLength": 1},
        "curator": {"type": "string", "minLength": 1},
        "recorded_at": {"type": "string", "format": "date"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"active_family": {"const": "Co-Fe"}}, "required": ["active_family"]},
      "then": {"required": ["scientific_hypothesis"], "properties": {"scientific_hypothesis": {"type": "string", "minLength": 1}}}
    },
    {
      "if": {"properties": {"active_phase": {"properties": {"status": {"const": "medida"}}, "required": ["status"]}}, "required": ["active_phase"]},
      "then": {"properties": {"active_phase": {"properties": {"evidence_ids": {"minItems": 1}}}}}
    }
  ]
}
