{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reacao-fischer-tropsch.local/schemas/ft-export-manifest-v1.schema.json",
  "title": "Manifesto de exportação FT v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["export_contract_version", "result_schema_version", "result_sha256", "deterministic_export", "files"],
  "properties": {
    "export_contract_version": {"const": "1.0.0"},
    "result_schema_version": {"type": "string", "minLength": 1},
    "result_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "deterministic_export": {"const": true},
    "files": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "media_type", "sha256", "bytes"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "media_type": {"enum": ["application/json", "text/csv"]},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "bytes": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}
