{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reacao-fischer-tropsch.local/schemas/ft-htft-validation-v1.schema.json",
  "type": "object",
  "required": ["schema_version", "regime", "model", "external_dataset", "evaluation", "independent_review", "recommendation_blocked"],
  "properties": {
    "schema_version": {"const": "1.0.0"}, "regime": {"const": "HTFT"},
    "model": {"type": "object", "required": ["model_id", "version", "frozen"], "properties": {"model_id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "frozen": {"type": "boolean"}}, "additionalProperties": false},
    "external_dataset": {"type": "object", "required": ["dataset_id", "row_count", "independent_from_calibration", "compatibility_review", "source_uri", "sha256"], "properties": {"dataset_id": {"type": "string", "minLength": 1}, "row_count": {"type": "integer", "minimum": 0}, "independent_from_calibration": {"type": "boolean"}, "compatibility_review": {"enum": ["pending", "accepted", "rejected"]}, "source_uri": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}}, "additionalProperties": false},
    "evaluation": {"type": "object", "required": ["metrics", "uncertainty_method", "residual_analysis"], "properties": {"metrics": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "uncertainty_method": {"type": "string", "minLength": 1}, "residual_analysis": {"type": "boolean"}}, "additionalProperties": false},
    "independent_review": {"type": "object", "required": ["independent", "reviewer_id", "status"], "properties": {"independent": {"type": "boolean"}, "reviewer_id": {"type": ["string", "null"]}, "status": {"enum": ["pending", "approved", "rejected"]}}, "additionalProperties": false},
    "recommendation_blocked": {"const": true}
  }, "additionalProperties": false
}
