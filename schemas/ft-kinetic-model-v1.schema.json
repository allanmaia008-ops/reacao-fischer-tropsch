{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reacao-fischer-tropsch.local/schemas/ft-kinetic-model-v1.schema.json",
  "title": "Contrato de modelo cinético Fischer-Tropsch v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "model_id", "model_version", "rate_expression", "variables", "parameters", "parameter_units", "applicability_domain", "source_ids", "uncertainty_method", "validation_dataset_ids", "calibration_status"],
  "properties": {
    "contract_version": {"const": "1.0.0"},
    "model_id": {"type": "string", "minLength": 1},
    "model_version": {"type": "string", "minLength": 1},
    "rate_expression": {"type": "string", "minLength": 1},
    "variables": {"type": "object", "required": ["temperature", "partial_pressure_H2", "partial_pressure_CO"], "additionalProperties": {"type": "string", "minLength": 1}},
    "parameters": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "number"}},
    "parameter_units": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
    "applicability_domain": {
      "type": "object",
      "required": ["ft_regime", "temperature_c", "pressure_bar", "catalyst_family"],
      "properties": {
        "ft_regime": {"enum": ["LTFT", "transicao", "HTFT"]},
        "temperature_c": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}], "minItems": 2, "maxItems": 2},
        "pressure_bar": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}], "minItems": 2, "maxItems": 2},
        "catalyst_family": {"enum": ["Co", "Fe", "Co-Fe"]}
      },
      "additionalProperties": true
    },
    "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "uncertainty_method": {"type": "string", "minLength": 1},
    "validation_dataset_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "calibration_status": {"enum": ["draft", "calibrated", "validated"]}
  }
}
