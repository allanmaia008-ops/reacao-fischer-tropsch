{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reacao-fischer-tropsch.local/schemas/ft-reactor-v1.schema.json",
  "title": "Contrato de reator Fischer-Tropsch v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "reactor_id", "reactor_type", "feed_molar_flow_mol_s", "temperature_c", "pressure_bar", "geometry", "energy_model", "pressure_drop_model", "mass_transfer_model", "wgs_model", "deactivation_model"],
  "properties": {
    "contract_version": {"const": "1.0.0"},
    "reactor_id": {"type": "string", "minLength": 1},
    "reactor_type": {"enum": ["fixed_bed_pfr", "slurry_cstr"]},
    "feed_molar_flow_mol_s": {"type": "object", "required": ["H2", "CO"], "additionalProperties": {"type": "number", "minimum": 0}},
    "temperature_c": {"type": "number", "exclusiveMinimum": 0},
    "pressure_bar": {"type": "number", "exclusiveMinimum": 0},
    "catalyst_mass_g": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "bed_volume_ml": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "ghsv_h_1": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "whsv_h_1": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "geometry": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "number", "exclusiveMinimum": 0}},
    "energy_model": {"type": "string", "minLength": 1},
    "pressure_drop_model": {"type": "string", "minLength": 1},
    "mass_transfer_model": {"type": "string", "minLength": 1},
    "wgs_model": {"type": "string", "minLength": 1},
    "deactivation_model": {"type": "string", "minLength": 1}
  }
}
