{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reacao-fischer-tropsch:result:2.0.0",
  "title": "Resultado Fischer-Tropsch v2",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version", "status", "ft_regime", "regime_envelope_version",
    "recommendation_blocked", "recommendation_blocking_reason", "warning"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "status": {"enum": ["orientacao_por_produto", "distribuicao_asf_condicional"]},
    "ft_regime": {"enum": ["nao_definido", "LTFT", "transicao", "HTFT"]},
    "regime_envelope_version": {"const": "1.0.0"},
    "recommendation_blocked": {"const": true},
    "recommendation_blocking_reason": {"type": "string", "minLength": 1},
    "warning": {"type": "string", "minLength": 1}
  }
}
