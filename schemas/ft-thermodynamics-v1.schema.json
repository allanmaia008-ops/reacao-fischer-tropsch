{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reacao-fischer-tropsch.local/schemas/ft-thermodynamics-v1.schema.json",
  "title": "Contrato termodinâmico Fischer-Tropsch v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "package_id", "package_version", "provider", "equation_of_state", "mixing_rule", "component_mapping", "pseudocomponent_method", "vle_method", "phase_coverage", "temperature_c", "pressure_bar", "source_ids", "validation_dataset_ids", "validation_metrics", "validation_status"],
  "properties": {
    "contract_version": {"const": "1.0.0"},
    "package_id": {"type": "string", "minLength": 1},
    "package_version": {"type": "string", "minLength": 1},
    "provider": {"type": "string", "minLength": 1},
    "equation_of_state": {"type": "string", "minLength": 1},
    "mixing_rule": {"type": "string", "minLength": 1},
    "component_mapping": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
    "pseudocomponent_method": {"type": "string", "minLength": 1},
    "vle_method": {"type": "string", "minLength": 1},
    "phase_coverage": {"type": "array", "uniqueItems": true, "items": {"enum": ["syngas", "water", "light_hydrocarbons", "liquid_hydrocarbons", "waxes"]}},
    "temperature_c": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}], "minItems": 2, "maxItems": 2},
    "pressure_bar": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}], "minItems": 2, "maxItems": 2},
    "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "validation_dataset_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "validation_metrics": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0}},
    "validation_status": {"enum": ["draft", "compared", "validated"]}
  }
}
